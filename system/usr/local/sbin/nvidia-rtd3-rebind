#!/bin/bash
# nvidia-rtd3-rebind: work around NVIDIA bug 7039712 (open-gpu-kernel-modules
# issue 1507). On Linux 7.3, the driver probes the GPU from a kernel thread that
# can no longer open the device's sysfs config file: runtime D3 reads "Not
# supported" and the GPU never powers off. Probing it again from a process
# (unbind, then bind) works. Run at boot by nvidia-rtd3-rebind.service, before
# ly and Ollama, while nothing uses the GPU. Temporary: listed under
# "Temporary workarounds" in ~/.dotfiles/README.md, with how to remove it.
set -uo pipefail
GPU=0000:01:00.0
POWER=/proc/driver/nvidia/gpus/$GPU/power
DRIVER=/sys/bus/pci/drivers/nvidia
status() { sed -n 's/^Runtime D3 status: *//p' "$POWER"; }

# udev may still be loading the driver
for _ in $(seq 60); do [[ -r $POWER ]] && break; sleep 0.5; done
[[ -r $POWER ]] || { echo "no NVIDIA GPU at $GPU: nothing to do"; exit 0; }
if [[ $(status) != "Not supported" ]]; then
    # The driver's own probe works: the bug is fixed (driver or kernel) and this
    # workaround can go. Hyprland's autostart turns the marker into a notification
    echo "runtime D3 works without help ($(status)): remove this workaround," \
        "see \"Temporary workarounds\" in ~/.dotfiles/README.md"
    touch /run/nvidia-rtd3-rebind.unneeded
    exit 0
fi
if fuser -s /dev/nvidia* /dev/dri/by-path/pci-$GPU-* 2>/dev/null; then
    echo "the GPU is in use: not probed again"
    exit 0
fi
exec 9>/run/nvidia-rtd3-rebind.lock
flock 9
# The modules above nvidia hold the GPU through it. rmmod, not modprobe -r:
# that also unloads nvidia itself once nothing uses it, and then there is no
# driver left to unbind from (what happened on the first try)
for module in nvidia_drm nvidia_modeset nvidia_uvm; do
    if [[ -d /sys/module/$module ]] && ! rmmod "$module"; then
        echo "could not unload $module: not probed again"
        modprobe nvidia_drm
        exit 1
    fi
done
if ! { echo "$GPU" > "$DRIVER/unbind" && echo "$GPU" > "$DRIVER/bind"; }; then
    echo "unbind or bind failed"
    modprobe nvidia_drm
    exit 1
fi
modprobe nvidia_drm
echo "probed again: runtime D3 $(status)"
[[ $(status) != "Not supported" ]]
