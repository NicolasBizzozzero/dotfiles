{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto"
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        // --- CUSTOM RICING MODULES ---
        {
            "type": "command",
            "key": "󰍜 Launcher",
            "text": "if grep -q 'rofi' ~/.config/hypr/hyprland.conf; then echo 'Rofi'; elif grep -q 'wofi' ~/.config/hypr/hyprland.conf; then echo 'Wofi'; else echo 'Unknown'; fi"
        },
        {
            "type": "command",
            "key": "󰓡 Status Bar",
            "text": "pgrep -x waybar >/dev/null && echo 'Waybar' || echo 'Not Running'"
        },
        {
            "type": "custom",
            "key": "󰂚 Notifications",
            "format": "mako"
        },
        {
            "type": "custom",
            "key": "󰈹 Web Browser",
            "format": "Firefox" 
        },
        {
            "type": "wm",
            "key": "󰏘 Compositor"
        },
        "break",
        "colors"
    ]
}
